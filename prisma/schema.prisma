generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  role String
  plan String @default("Blue Horizon")
  clinicId String?
  clinic Clinic? @relation(fields: [clinicId], references: [id])
  visitType String?
  assignedPriorities WaitlistPriority[] @relation("PriorityAssigner")
  priorityHistory PriorityHistory[] @relation("PriorityActor")
  account Account?
  verifiedMemberships ClinicMembership[] @relation("MembershipVerifier")
  sentInvitations StaffInvitation[] @relation("InvitationSender")
  intake Intake?
  tags SymptomTag[]
  bookings Booking[]
  waitlists Waitlist[]
  offers Offer[]
  notifications Notification[]
}
model Clinic {
  id String @id
  name String
  city String
  address String
  description String
  timezone String @default("America/Los_Angeles")
  users User[]
  slots Slot[]
  memberships ClinicMembership[]
  invitations StaffInvitation[]
  audits Audit[]
  priorities WaitlistPriority[]
  tags SymptomTag[]
}
model Slot {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id])
  service String
  requiresReferral Boolean @default(false)
  requiresAuthorization Boolean @default(false)
  provider String
  start DateTime
  end DateTime
  price Int
  plans String[]
  status String @default("AVAILABLE")
  bookings Booking[]
  offers Offer[]
  suggestions Suggestion[]
  sequences NotificationSequence[]
  @@index([clinicId, start])
}
model Booking {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  status String @default("CONFIRMED")
  createdAt DateTime @default(now())
  replacementId String?
  replacement Booking? @relation("BookingReplacement", fields: [replacementId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  replaces Booking? @relation("BookingReplacement")
  waitlists Waitlist[]
  @@index([patientId, status])
  @@unique([id, patientId])
  @@unique([replacementId, patientId])
}
model Waitlist {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  service String
  plan String
  city String @default("")
  clinicIds String[]
  maxPrice Int
  earliest DateTime
  latest DateTime
  startHour Int @default(0)
  endHour Int @default(24)
  weekdays Int[]
  bookingId String?
  booking Booking? @relation(fields: [bookingId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  offers Offer[]
  suggestions Suggestion[]
  priorities WaitlistPriority[]
  @@unique([id, patientId])
}
model Suggestion {
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  waitlistId String
  waitlist Waitlist @relation(fields: [waitlistId], references: [id])
  reasons String[]
  @@unique([slotId, waitlistId])
}
model Offer {
  groupId String?
  group NotificationGroup? @relation(fields: [groupId], references: [id])
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  waitlistId String
  patientId String
  waitlist Waitlist @relation(fields: [waitlistId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  patient User @relation(fields: [patientId], references: [id])
  status String @default("PENDING")
  reason String
  expiresAt DateTime
  createdAt DateTime @default(now())
  notifications Notification[]
}
model Notification {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  offerId String?
  offer Offer? @relation(fields: [offerId], references: [id])
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id])
  actor String
  action String
  createdAt DateTime @default(now())
}
model Intake {
  patientId String @id
  patient User @relation(fields: [patientId], references: [id])
  answers Json
  completedAt DateTime @default(now())
}
model SymptomTag {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  label String
  score Int
  source String
  clinicId String?
  clinic Clinic? @relation(fields: [clinicId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt
  @@index([patientId])
}

model WaitlistPriority {
  id String @id @default(cuid())
  waitlistId String
  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Restrict)
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  level String?
  referralApproved Boolean @default(false)
  authorizationApproved Boolean @default(false)
  reviewState String @default("UNREVIEWED")
  assignedById String?
  assignedBy User? @relation("PriorityAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt DateTime?
  reason String @default("")
  version Int @default(0)
  history PriorityHistory[]
  @@unique([waitlistId, clinicId])
  @@index([clinicId])
}
model PriorityHistory {
  id String @id @default(cuid())
  priorityId String
  priority WaitlistPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  previousLevel String?
  level String?
  actorId String
  actor User @relation("PriorityActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason String
  version Int
  createdAt DateTime @default(now())
  @@unique([priorityId, version])
}

model Account {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields: [userId], references: [id])
 username String @unique
 email String @unique
 passwordHash String
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 sessions AccountSession[]
 membership ClinicMembership?
 usedInvitations StaffInvitation[] @relation("InvitationRecipient")
}
model AccountSession {
 id String @id @default(cuid())
 tokenHash String @unique
 accountId String
 account Account @relation(fields:[accountId],references:[id])
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([accountId])
}
model ClinicMembership {
 id String @id @default(cuid())
 accountId String @unique
 account Account @relation(fields:[accountId],references:[id])
 clinicId String
 clinic Clinic @relation(fields:[clinicId],references:[id])
 role String
 status String
 verifiedById String?
 verifiedBy User? @relation("MembershipVerifier",fields:[verifiedById],references:[id])
 verifiedAt DateTime?
 verificationMode String @default("MOCK")
 createdAt DateTime @default(now())
}
model StaffInvitation {
 id String @id @default(cuid())
 clinicId String
 clinic Clinic @relation(fields:[clinicId],references:[id])
 email String
 tokenHash String @unique
 invitedById String
 invitedBy User @relation("InvitationSender",fields:[invitedById],references:[id])
 expiresAt DateTime
 status String @default("PENDING")
 usedById String?
 usedBy Account? @relation("InvitationRecipient",fields:[usedById],references:[id])
 createdAt DateTime @default(now())
}
model LoginThrottle {
 bucket String @id
 attempts Int
 windowStart DateTime
}

model NotificationSequence {
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  authorizedById String
  state String @default("DRAFT")
  nextSendAt DateTime?
  lastSentAt DateTime?
  firstGroup Int
  reason String
  createdAt DateTime @default(now())
  groups NotificationGroup[]
  @@index([state, nextSendAt])
}
model NotificationGroup {
  id String @id @default(cuid())
  sequenceId String
  sequence NotificationSequence @relation(fields: [sequenceId], references: [id])
  level String
  status String @default("APPROVED")
  recipients Json
  sentAt DateTime?
  note String @default("")
  offers Offer[]
  @@unique([sequenceId, level])
}
