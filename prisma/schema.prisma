generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  role String
  plan String @default("Blue Horizon")
  planType String?
  clinicId String?
  clinic Clinic? @relation(fields: [clinicId], references: [id])
  visitType String?
  assignedPriorities WaitlistPriority[] @relation("PriorityAssigner")
  priorityHistory PriorityHistory[] @relation("PriorityActor")
  account Account?
  verifiedMemberships ClinicMembership[] @relation("MembershipVerifier")
  recordImports MedicalRecordImport[]
  sentInvitations StaffInvitation[] @relation("InvitationSender")
  intake Intake?
  tags SymptomTag[]
  bookings Booking[]
  waitlists Waitlist[]
  offers Offer[]
  notifications Notification[]
}
model Clinic {
  id String @id
  name String
  city String
  address String
  description String
  timezone String @default("America/Los_Angeles")
  recordImports MedicalRecordImport[]
  users User[]
  slots Slot[]
  memberships ClinicMembership[]
  invitations StaffInvitation[]
  audits Audit[]
  priorities WaitlistPriority[]
  tags SymptomTag[]
}
model Slot {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id])
  service String
  requiresReferral Boolean @default(false)
  requiresAuthorization Boolean @default(false)
  provider String
  start DateTime
  end DateTime
  price Int
  plans String[]
  status String @default("AVAILABLE")
  bookings Booking[]
  offers Offer[]
  suggestions Suggestion[]
  sequences NotificationSequence[]
  @@index([clinicId, start])
}
model Booking {
  needId String?
  patientNeed PatientNeed? @relation("NeedBookings", fields: [needId, patientId], references: [id, patientId])
  originalFor PatientNeed? @relation("NeedOriginal")
  currentFor PatientNeed? @relation("NeedCurrent")
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  status String @default("CONFIRMED")
  createdAt DateTime @default(now())
  replacementId String?
  replacement Booking? @relation("BookingReplacement", fields: [replacementId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  replaces Booking? @relation("BookingReplacement")
  waitlists Waitlist[]
  @@index([patientId, status])
  @@unique([id, patientId])
  @@unique([replacementId, patientId])
}
model Waitlist {
  needId String?
  patientNeed PatientNeed? @relation(fields: [needId, patientId], references: [id, patientId])
  externalAppointmentId String?
  externalAppointment ExternalAppointment? @relation(fields: [externalAppointmentId, patientId], references: [id, patientId])
  requiresReferral Boolean @default(false)
  requiresAuthorization Boolean @default(false)
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  service String
  plan String
  city String @default("")
  clinicIds String[]
  maxPrice Int
  earliest DateTime
  latest DateTime
  startHour Int @default(0)
  endHour Int @default(24)
  weekdays Int[]
  bookingId String?
  booking Booking? @relation(fields: [bookingId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  offers Offer[]
  suggestions Suggestion[]
  priorities WaitlistPriority[]
  @@unique([id, patientId])
}
model Suggestion {
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  waitlistId String
  waitlist Waitlist @relation(fields: [waitlistId], references: [id])
  reasons String[]
  @@unique([slotId, waitlistId])
}
model Offer {
  groupId String?
  group NotificationGroup? @relation(fields: [groupId], references: [id])
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  waitlistId String
  patientId String
  waitlist Waitlist @relation(fields: [waitlistId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Cascade)
  patient User @relation(fields: [patientId], references: [id])
  status String @default("PENDING")
  reason String
  expiresAt DateTime
  createdAt DateTime @default(now())
  notifications Notification[]
}
model Notification {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  offerId String?
  offer Offer? @relation(fields: [offerId], references: [id])
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
}
model Audit {
  id String @id @default(cuid())
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id])
  actor String
  action String
  createdAt DateTime @default(now())
}
model Intake {
  patientId String @id
  patient User @relation(fields: [patientId], references: [id])
  answers Json
  completedAt DateTime @default(now())
}
model SymptomTag {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  label String
  score Int
  source String
  clinicId String?
  clinic Clinic? @relation(fields: [clinicId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt
  @@index([patientId])
}

model WaitlistPriority {
  id String @id @default(cuid())
  waitlistId String
  waitlist Waitlist @relation(fields: [waitlistId], references: [id], onDelete: Restrict)
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  level String?
  referralApproved Boolean @default(false)
  authorizationApproved Boolean @default(false)
  reviewState String @default("UNREVIEWED")
  assignedById String?
  assignedBy User? @relation("PriorityAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt DateTime?
  reason String @default("")
  version Int @default(0)
  history PriorityHistory[]
  @@unique([waitlistId, clinicId])
  @@index([clinicId])
}
model PriorityHistory {
  id String @id @default(cuid())
  priorityId String
  priority WaitlistPriority @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  previousLevel String?
  level String?
  actorId String
  actor User @relation("PriorityActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason String
  version Int
  createdAt DateTime @default(now())
  @@unique([priorityId, version])
}

model Account {
 id String @id @default(cuid())
 userId String @unique
 user User @relation(fields: [userId], references: [id])
 username String @unique
 email String @unique
 passwordHash String
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 sessions AccountSession[]
 membership ClinicMembership?
 usedInvitations StaffInvitation[] @relation("InvitationRecipient")
}
model AccountSession {
 id String @id @default(cuid())
 tokenHash String @unique
 accountId String
 account Account @relation(fields:[accountId],references:[id])
 expiresAt DateTime
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([accountId])
}
model ClinicMembership {
  canAuthorMedicalTags Boolean @default(false)
 id String @id @default(cuid())
 accountId String @unique
 account Account @relation(fields:[accountId],references:[id])
 clinicId String
 clinic Clinic @relation(fields:[clinicId],references:[id])
 role String
 status String
 verifiedById String?
 verifiedBy User? @relation("MembershipVerifier",fields:[verifiedById],references:[id])
 verifiedAt DateTime?
 verificationMode String @default("MOCK")
 createdAt DateTime @default(now())
}
model StaffInvitation {
 id String @id @default(cuid())
 clinicId String
 clinic Clinic @relation(fields:[clinicId],references:[id])
 email String
 tokenHash String @unique
 invitedById String
 invitedBy User @relation("InvitationSender",fields:[invitedById],references:[id])
 expiresAt DateTime
 status String @default("PENDING")
 usedById String?
 usedBy Account? @relation("InvitationRecipient",fields:[usedById],references:[id])
 createdAt DateTime @default(now())
}
model LoginThrottle {
 bucket String @id
 attempts Int
 windowStart DateTime
}

model NotificationSequence {
  id String @id @default(cuid())
  slotId String
  slot Slot @relation(fields: [slotId], references: [id])
  authorizedById String
  state String @default("DRAFT")
  nextSendAt DateTime?
  lastSentAt DateTime?
  firstGroup Int
  reason String
  createdAt DateTime @default(now())
  groups NotificationGroup[]
  @@index([state, nextSendAt])
}
model NotificationGroup {
  id String @id @default(cuid())
  sequenceId String
  sequence NotificationSequence @relation(fields: [sequenceId], references: [id])
  level String
  status String @default("APPROVED")
  recipients Json
  sentAt DateTime?
  note String @default("")
  offers Offer[]
  @@unique([sequenceId, level])
}

model MedicalNeed {
  id String @id @default(cuid())
  patientId String
  clinicId String
  sourceBookingId String?
  sourceImportId String?
  title String
  service String
  createdById String
  createdAt DateTime @default(now())
  sourceImport MedicalRecordImport? @relation("ImportNeeds", fields: [sourceImportId, patientId, clinicId], references: [id, patientId, clinicId])
  tags MedicalTag[]
  @@unique([id, patientId, clinicId])
}
model MedicalTag {
  patientNeedLinks PatientNeedEvidence[]
  @@unique([id, patientId])
  id String @id @default(cuid())
  needId String
  patientId String
  clinicId String
  need MedicalNeed @relation(fields: [needId, patientId, clinicId], references: [id, patientId, clinicId])
  sourceBookingId String?
  sourceImportId String?
  authorId String
  updatedById String
  reviewedById String?
  reviewedAt DateTime?
  sourceImport MedicalRecordImport? @relation("ImportTags", fields: [sourceImportId, patientId, clinicId], references: [id, patientId, clinicId])
  sourceRecordId String?
  sourceExcerpt String?
  sourceRecord ImportedMedicalRecord? @relation(fields: [sourceRecordId, sourceImportId], references: [id, importId])
  sourceType String @default("CLINICIAN_VISIT")
  kind String
  label String
  clinicalNotes String
  followUpRecommendation String
  recommendedFrom DateTime?
  recommendedBy DateTime?
  requiresReferral Boolean @default(false)
  requiresAuthorization Boolean @default(false)
  state String @default("DRAFT")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions MedicalTagRevision[]
  @@index([clinicId, patientId, state])
}
model MedicalTagRevision {
  id String @id @default(cuid())
  tagId String
  tag MedicalTag @relation(fields: [tagId], references: [id])
  version Int
  actorId String
  action String
  reason String
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([tagId, version])
}

model MedicalRecordImport {
  id String @id @default(cuid())
  patientId String
  patient User @relation(fields: [patientId], references: [id])
  clinicId String
  clinic Clinic @relation(fields: [clinicId], references: [id])
  requestId String
  source String @default("CAREOUSEL_SYNTHETIC_FHIR_V1")
  consentVersion String @default("SYNTHETIC_V1")
  state String @default("ACTIVE")
  version Int @default(1)
  consentedAt DateTime @default(now())
  revokedAt DateTime?
  records ImportedMedicalRecord[]
  suggestions ImportedTagSuggestion[]
  audits MedicalRecordAudit[]
  needs MedicalNeed[] @relation("ImportNeeds")
  tags MedicalTag[] @relation("ImportTags")
  @@unique([patientId, requestId])
  @@unique([id, patientId, clinicId])
}
model ImportedMedicalRecord {
  id String @id @default(cuid())
  importId String
  recordImport MedicalRecordImport @relation(fields: [importId], references: [id])
  resourceId String
  resourceType String
  text String
  resource Json
  contentHash String
  tags MedicalTag[]
  suggestion ImportedTagSuggestion?
  @@unique([id, importId])
  @@unique([importId, resourceId])
}
model ImportedTagSuggestion {
  id String @id @default(cuid())
  importId String
  recordImport MedicalRecordImport @relation(fields: [importId], references: [id])
  recordId String @unique
  @@unique([recordId, importId])
  record ImportedMedicalRecord @relation(fields: [recordId, importId], references: [id, importId])
  excerpt String
  originalFields Json
  fields Json
  method String
  explanation String
  state String @default("PENDING")
  version Int @default(1)
  reviewedById String?
  reviewedAt DateTime?
  tagId String? @unique
  createdAt DateTime @default(now())
}
model MedicalRecordAudit {
  id String @id @default(cuid())
  importId String
  recordImport MedicalRecordImport @relation(fields: [importId], references: [id])
  actorId String
  action String
  details Json
  createdAt DateTime @default(now())
  @@index([importId, createdAt])
}

model PatientNeed {
  id String @id @default(cuid())
  patientId String
  title String
  service String
  preferences Json
  requiresReferral Boolean @default(false)
  requiresAuthorization Boolean @default(false)
  state String @default("OPEN")
  version Int @default(1)
  @@unique([originalBookingId, patientId])
  @@unique([currentBookingId, patientId])
  @@unique([externalAppointmentId, patientId])
  originalBookingId String? @unique
  originalBooking Booking? @relation("NeedOriginal", fields: [originalBookingId, patientId], references: [id, patientId])
  currentBookingId String? @unique
  currentBooking Booking? @relation("NeedCurrent", fields: [currentBookingId, patientId], references: [id, patientId])
  externalAppointmentId String? @unique
  externalAppointment ExternalAppointment? @relation(fields: [externalAppointmentId, patientId], references: [id, patientId])
  bookings Booking[] @relation("NeedBookings")
  waitlists Waitlist[]
  evidence PatientNeedEvidence[]
  history PatientNeedHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, patientId])
}
model ExternalAppointment {
  reportKey String
  @@unique([patientId, reportKey])
  id String @id @default(cuid())
  patientId String
  clinicName String
  service String
  start DateTime
  end DateTime
  location String
  reference String
  reportedConfirmed Boolean
  reportedCancelled Boolean @default(false)
  verification String @default("PATIENT_REPORTED_UNVERIFIED")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  need PatientNeed?
  waitlists Waitlist[]
  @@unique([id, patientId])
}
model PatientNeedEvidence {
  needId String
  patientId String
  tagId String
  need PatientNeed @relation(fields: [needId, patientId], references: [id, patientId])
  tag MedicalTag @relation(fields: [tagId, patientId], references: [id, patientId])
  @@id([needId, tagId])
}
model PatientNeedHistory {
  id String @id @default(cuid())
  needId String
  need PatientNeed @relation(fields: [needId], references: [id])
  version Int
  actorId String
  action String
  details Json
  createdAt DateTime @default(now())
  @@unique([needId, version])
}
